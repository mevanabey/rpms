# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# pnpm's virtual store, relocated by .npmrc. Desktop & Documents iCloud sync is
# enabled on this machine, and iCloud evicts package files, which stalled tsc
# and eslint for seconds per file. Anything ending in .nosync is ignored by
# iCloud Drive, so the real package content lives here instead.
/.pnpm.nosync
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next.nosync/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
